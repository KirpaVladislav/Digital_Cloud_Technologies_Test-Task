<Window x:Class="Digital_Cloud_Technologies_Test_Task.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Digital_Cloud_Technologies_Test_Task"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="97*"/>
            <ColumnDefinition Width="303*"/>
        </Grid.ColumnDefinitions>
        <Button Content="Підключити" HorizontalAlignment="Left" Margin="0,313,0,0" x:Name="MainButton" VerticalAlignment="Top" Click="MainButton_Click" Height="82" Width="155"/>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="CoinsDataGrid" AutoGenerateColumns ="True"  Margin="10,0,0,170" Grid.ColumnSpan="2"/>

        <Button Grid.Column="1" Content="Знайти" x:Name="FindButton" Margin="438,375,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.011,0.259" Click="FindButton_Click"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" x:Name="SearchField" Margin="438,342,0,0" TextWrapping="Wrap" Text="Введіть назву для пошуку" VerticalAlignment="Top" Width="168"/>

    </Grid>
</Window>
